{
  "id": "cognitive-runtime",
  "name": "Stella Runtime",
  "description": "Instance-neutral cognitive runtime for OpenClaw",
  "version": "0.2.1",
  "skills": [
    "skills/framework-admission"
  ],
  "activation": {
    "onStartup": true,
    "onCommands": [
      "cognitive"
    ],
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stella": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "instance_id", "personal_data_repository"],
        "properties": {
          "schema_version": { "const": "stella.personal-data-locator/v1" },
          "instance_id": { "$ref": "#/$defs/id" },
          "personal_data_repository": {
            "type": "string",
            "minLength": 2,
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
          }
        }
      },
      "runtime": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "instance_id", "mode", "runtime_storage", "generation_storage", "host", "authority_owner", "limits", "adapters"],
        "properties": {
          "schema_version": { "const": "cognitive-runtime.instance-runtime-config/v2" },
          "instance_id": { "$ref": "#/$defs/id" },
          "mode": { "enum": ["off", "observe", "enforce"] },
          "runtime_storage": { "type": "string", "minLength": 1 },
          "generation_storage": { "type": "string", "minLength": 1 },
          "host": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent_id", "eligible_scope"],
            "properties": {
              "agent_id": { "$ref": "#/$defs/id" },
              "eligible_scope": {
                "const": ["private_main_session"]
              }
            }
          },
          "authority_owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "actor_id"],
            "properties": {
              "provider": { "const": "telegram" },
              "actor_id": { "type": "string", "minLength": 1 }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_active_runs", "drain_timeout_ms"],
            "properties": {
              "max_active_runs": { "type": "integer", "minimum": 1 },
              "drain_timeout_ms": { "type": "integer", "minimum": 1 }
            }
          },
          "adapters": {
            "type": "object",
            "additionalProperties": false,
            "required": ["authority_checkout", "host_retrieval"],
            "properties": {
              "authority_checkout": { "type": "string", "minLength": 1 },
              "host_retrieval": { "type": "string", "minLength": 1 },
              "public_corpus": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "recovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stateRoot", "activeInstanceId", "instances"],
        "properties": {
          "stateRoot": {
            "type": "string",
            "minLength": 1
          },
          "activeInstanceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "instances": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authorityRevision"],
              "properties": {
                "authorityRevision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "$defs": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
    }
  }
}
