{
  "id": "cognitive-runtime",
  "name": "Stella Runtime",
  "description": "Instance-neutral cognitive runtime for OpenClaw",
  "version": "0.0.0",
  "skills": [
    "skills/framework-admission"
  ],
  "activation": {
    "onStartup": true,
    "onCommands": [
      "cognitive"
    ],
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "recovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stateRoot", "instances"],
        "properties": {
          "stateRoot": {
            "type": "string",
            "minLength": 1
          },
          "instances": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authorityRevision"],
              "properties": {
                "authorityRevision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
