{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.state-correction-receipt/v2",
  "title": "State Correction Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "preview_id", "preview_checksum", "base_state_view_checksum", "confirmed_by", "confirmation_method", "confirmed_at", "single_use"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.state-correction-receipt/v2" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "preview_id": { "$ref": "#/$defs/id" },
    "preview_checksum": { "$ref": "#/$defs/checksum" },
    "base_state_view_checksum": { "$ref": "#/$defs/checksum" },
    "confirmed_by": { "$ref": "#/$defs/id" },
    "confirmation_method": { "enum": ["cli_plan_apply", "confirmed_channel"] },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "single_use": { "const": true }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }, "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
