{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.generation-manifest/v2",
  "title": "Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "builder_format_version", "package_version", "source_revision", "sync_generation", "files"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.generation-manifest/v2" },
    "contract_version": { "const": "v2" },
    "builder_format_version": { "const": "generation-builder/v2" },
    "package_version": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sync_generation": { "$ref": "#/$defs/generation" },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "generation": { "type": "string", "pattern": "^generation-[a-f0-9]{64}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "checksum", "dependencies"], "properties": { "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }, "checksum": { "$ref": "#/$defs/checksum" }, "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }
  }
}
