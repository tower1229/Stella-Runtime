{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.candidate-review-artifact/v2",
  "title": "Candidate Review Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "candidate_id", "candidate_revision", "candidate_checksum", "complete_candidate", "base_authority_version", "exact_diff", "source_map", "created_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.candidate-review-artifact/v2" },
    "review_id": { "$ref": "#/$defs/id" },
    "candidate_id": { "$ref": "#/$defs/id" },
    "candidate_revision": { "type": "integer", "minimum": 1 },
    "candidate_checksum": { "$ref": "#/$defs/checksum" },
    "complete_candidate": { "type": "object" },
    "base_authority_version": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "exact_diff": { "type": "string", "minLength": 1 },
    "source_map": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
