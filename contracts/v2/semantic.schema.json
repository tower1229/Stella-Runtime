{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.semantic/v2",
  "title": "Semantic Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "record_type", "aliases", "scope", "valid_time", "epistemic", "confidence", "source_refs", "related_claims", "supersedes", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.semantic/v2" },
    "claim_id": { "$ref": "#/$defs/stableId" },
    "record_type": { "type": "string", "not": { "const": "personal_model" }, "minLength": 1 },
    "aliases": { "$ref": "#/$defs/uniqueStrings" },
    "scope": { "$ref": "#/$defs/scope" },
    "valid_time": { "$ref": "#/$defs/validTime" },
    "epistemic": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["low", "medium", "high"] },
    "source_refs": { "$ref": "#/$defs/nonEmptyRefs" },
    "related_claims": { "$ref": "#/$defs/uniqueRefs" },
    "supersedes": { "$ref": "#/$defs/uniqueRefs" },
    "created_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "date": { "type": "string", "format": "date" },
    "uniqueStrings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "uniqueRefs": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
    "nonEmptyRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
    "scope": { "type": "object", "additionalProperties": false, "required": ["contexts", "conditions"], "properties": { "contexts": { "$ref": "#/$defs/uniqueStrings" }, "conditions": { "$ref": "#/$defs/uniqueStrings" } } },
    "validTime": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "$ref": "#/$defs/date" }, "to": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/date" }] } } }
  }
}
