{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.state-view/v2",
  "title": "State View",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "view_version", "active_seq", "values", "checksum", "created_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.state-view/v2" },
    "instance_id": { "$ref": "#/$defs/id" },
    "view_version": { "type": "string", "minLength": 1 },
    "active_seq": { "type": "integer", "minimum": 0 },
    "values": { "type": "array", "items": { "$ref": "#/$defs/value" } },
    "checksum": { "$ref": "#/$defs/checksum" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "value": { "type": "object", "additionalProperties": false, "required": ["state_id", "value", "source_event_id"], "properties": { "state_id": { "$ref": "#/$defs/id" }, "value": {}, "source_event_id": { "$ref": "#/$defs/id" } } }
  }
}
