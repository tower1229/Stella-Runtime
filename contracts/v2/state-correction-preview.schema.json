{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.state-correction-preview/v2",
  "title": "State Correction Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preview_id", "instance_id", "base_state_view_checksum", "proposed_event", "preview_checksum", "created_at", "expires_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.state-correction-preview/v2" },
    "preview_id": { "$ref": "#/$defs/id" },
    "instance_id": { "$ref": "#/$defs/id" },
    "base_state_view_checksum": { "$ref": "#/$defs/checksum" },
    "proposed_event": { "type": "object" },
    "preview_checksum": { "$ref": "#/$defs/checksum" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }, "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
