{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.change-set/v2",
  "title": "Change Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_set_id", "approval_receipt_id", "candidate_id", "candidate_revision", "candidate_checksum", "base_authority_version", "base_checksum", "operations", "checksum", "created_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.change-set/v2" },
    "change_set_id": { "$ref": "#/$defs/id" },
    "approval_receipt_id": { "$ref": "#/$defs/id" },
    "candidate_id": { "$ref": "#/$defs/id" },
    "candidate_revision": { "type": "integer", "minimum": 1 },
    "candidate_checksum": { "$ref": "#/$defs/checksum" },
    "base_authority_version": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "base_checksum": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/checksum" }] },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } },
    "checksum": { "$ref": "#/$defs/checksum" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "operation": { "type": "object", "additionalProperties": false, "required": ["operation", "path", "content_checksum"], "properties": { "operation": { "enum": ["write", "delete"] }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }, "content_checksum": { "$ref": "#/$defs/checksum" } } }
  }
}
