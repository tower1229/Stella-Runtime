{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.discovery-authorization/v2",
  "title": "Discovery Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "instance_id", "scope", "granted_by", "granted_at", "expires_at", "status"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.discovery-authorization/v2" },
    "authorization_id": { "$ref": "#/$defs/id" },
    "instance_id": { "$ref": "#/$defs/id" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_types", "source_refs"],
      "properties": {
        "candidate_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["semantic", "personal_model", "cognitive"] } },
        "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "granted_by": { "$ref": "#/$defs/id" },
    "granted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "ended"] }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" } }
}
