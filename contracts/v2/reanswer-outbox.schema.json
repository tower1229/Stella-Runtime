{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.reanswer-outbox/v2",
  "title": "Reanswer Outbox",
  "type": "object",
  "additionalProperties": false,
  "required": ["correction_id", "instance_id", "session_key_hash", "prior_run_id", "new_view_version", "status", "attempt_count", "successful_completion_count", "idempotency_key", "created_at", "updated_at"],
  "properties": {
    "correction_id": { "$ref": "#/$defs/id" },
    "instance_id": { "$ref": "#/$defs/id" },
    "session_key_hash": { "$ref": "#/$defs/checksum" },
    "prior_run_id": { "$ref": "#/$defs/id" },
    "new_view_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "in_flight", "completed"] },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "successful_completion_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "successor_run_id": { "$ref": "#/$defs/id" },
    "last_error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "completed" } } }, "then": { "required": ["successor_run_id"], "properties": { "successful_completion_count": { "const": 1 } } } },
    { "if": { "properties": { "status": { "enum": ["pending", "in_flight"] } } }, "then": { "properties": { "successful_completion_count": { "const": 0 } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
