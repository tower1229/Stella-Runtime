{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.activation-receipt/v2",
  "title": "Activation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "instance_id", "generation_id", "source_revision", "manifest_checksum", "projection_checksum", "host_config_checksum", "index_evidence", "release_channel", "openclaw_version", "node_version", "verified_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.activation-receipt/v2" },
    "receipt_id": { "$ref": "#/$defs/id" },
    "instance_id": { "$ref": "#/$defs/id" },
    "generation_id": { "$ref": "#/$defs/generation" },
    "source_revision": { "type": "string", "minLength": 1 },
    "manifest_checksum": { "$ref": "#/$defs/checksum" },
    "projection_checksum": { "$ref": "#/$defs/checksum" },
    "host_config_checksum": { "$ref": "#/$defs/checksum" },
    "index_evidence": { "type": "object", "additionalProperties": false, "required": ["deep_status", "search_sentinel_checksum", "get_sentinel_checksum"], "properties": { "deep_status": { "const": "pass" }, "search_sentinel_checksum": { "$ref": "#/$defs/checksum" }, "get_sentinel_checksum": { "$ref": "#/$defs/checksum" } } },
    "cutover_plan_checksum": { "$ref": "#/$defs/checksum" },
    "release_channel": { "type": "string", "minLength": 1 },
    "openclaw_version": { "type": "string", "minLength": 1 },
    "node_version": { "type": "string", "minLength": 1 },
    "verified_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }, "generation": { "type": "string", "pattern": "^generation-[a-f0-9]{64}$" }, "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
