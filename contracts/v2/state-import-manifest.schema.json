{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.state-import-manifest/v2",
  "title": "State Import Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "import_id", "instance_id", "initialized_head_checksum", "events", "source_mappings", "expected_head", "expected_view", "checksum", "created_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.state-import-manifest/v2" },
    "import_id": { "$ref": "#/$defs/id" },
    "instance_id": { "$ref": "#/$defs/id" },
    "initialized_head_checksum": { "$ref": "#/$defs/checksum" },
    "events": { "type": "array", "items": { "type": "object" } },
    "source_mappings": { "type": "array", "items": { "$ref": "#/$defs/sourceMapping" } },
    "expected_head": { "type": "object" },
    "expected_view": { "type": "object" },
    "checksum": { "$ref": "#/$defs/checksum" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceMapping": { "type": "object", "additionalProperties": false, "required": ["event_id", "source_kind", "source_ref", "verification"], "properties": { "event_id": { "$ref": "#/$defs/id" }, "source_kind": { "enum": ["user_confirmed", "independently_verified"] }, "source_ref": { "$ref": "#/$defs/id" }, "verification": { "type": "string", "minLength": 1 } } }
  }
}
