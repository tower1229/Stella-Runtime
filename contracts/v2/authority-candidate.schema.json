{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.authority-candidate/v2",
  "title": "Authority Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "revision", "candidate_type", "stable_id", "base_authority_version", "base_checksum", "content", "source_map", "exact_diff", "checksum", "created_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.authority-candidate/v2" },
    "candidate_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "candidate_type": { "enum": ["semantic", "personal_model", "cognitive"] },
    "stable_id": { "$ref": "#/$defs/id" },
    "base_authority_version": { "$ref": "#/$defs/nullableVersion" },
    "base_checksum": { "$ref": "#/$defs/nullableChecksum" },
    "content": { "type": "object" },
    "source_map": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceMap" } },
    "exact_diff": { "type": "string", "minLength": 1 },
    "checksum": { "$ref": "#/$defs/checksum" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableChecksum": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/checksum" }] },
    "nullableVersion": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "sourceMap": { "type": "object", "additionalProperties": false, "required": ["source_ref", "content_path"], "properties": { "source_ref": { "$ref": "#/$defs/id" }, "content_path": { "type": "string", "minLength": 1 } } }
  }
}
