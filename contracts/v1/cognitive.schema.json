{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.cognitive/v1",
  "title": "Cognitive Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cognitive_id", "entity_type", "entity_version", "title", "aliases", "cognitive_jobs", "route_signals", "relations", "source_refs", "confirmed_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.cognitive/v1" },
    "cognitive_id": { "$ref": "#/$defs/stableId" },
    "entity_type": { "enum": ["governing_system", "governing_module", "epistemic_method", "decision_framework", "reflection_framework"] },
    "entity_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "aliases": { "$ref": "#/$defs/uniqueStrings" },
    "cognitive_jobs": { "$ref": "#/$defs/nonEmptyStrings" },
    "route_signals": { "$ref": "#/$defs/uniqueStrings" },
    "relations": {
      "type": "object", "additionalProperties": false,
      "required": ["governed_by", "parent", "complements", "tensions"],
      "properties": {
        "governed_by": { "$ref": "#/$defs/nullableId" },
        "parent": { "$ref": "#/$defs/nullableId" },
        "complements": { "$ref": "#/$defs/uniqueIds" },
        "tensions": { "$ref": "#/$defs/uniqueIds" }
      }
    },
    "source_refs": { "$ref": "#/$defs/nonEmptyIds" },
    "confirmed_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "nullableId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stableId" }] },
    "uniqueIds": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
    "nonEmptyIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
    "uniqueStrings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "date": { "type": "string", "format": "date" }
  }
}
