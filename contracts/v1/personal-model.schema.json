{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.personal-model/v1",
  "title": "Personal Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "record_type", "scope", "epistemic", "confidence", "source_refs", "counterevidence_refs", "competing_explanations", "revision_triggers", "supersedes", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.personal-model/v1" },
    "claim_id": { "$ref": "#/$defs/stableId" },
    "record_type": { "const": "personal_model" },
    "scope": { "$ref": "#/$defs/scope" },
    "epistemic": { "const": "user_confirmed_hypothesis" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "source_refs": { "$ref": "#/$defs/nonEmptyRefs" },
    "counterevidence_refs": { "$ref": "#/$defs/uniqueRefs" },
    "competing_explanations": { "$ref": "#/$defs/nonEmptyStrings" },
    "revision_triggers": { "$ref": "#/$defs/nonEmptyStrings" },
    "supersedes": { "$ref": "#/$defs/uniqueRefs" },
    "created_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" }
  },
  "anyOf": [
    { "properties": { "counterevidence_refs": { "minItems": 1 } } },
    { "properties": { "competing_explanations": { "minItems": 1 } } }
  ],
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "date": { "type": "string", "format": "date" },
    "uniqueRefs": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
    "nonEmptyRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "scope": { "type": "object", "additionalProperties": false, "required": ["contexts", "conditions"], "properties": { "contexts": { "$ref": "#/$defs/nonEmptyStrings" }, "conditions": { "$ref": "#/$defs/nonEmptyStrings" } } }
  }
}
