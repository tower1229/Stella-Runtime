{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.current-state-head/v1",
  "title": "Current State Head",
  "type": "object",
  "additionalProperties": false,
  "required": ["active_seq", "view_version", "checksum", "activated_at"],
  "properties": {
    "active_seq": { "type": "integer", "minimum": 0 },
    "view_version": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "activated_at": { "type": "string", "format": "date-time" }
  }
}
