{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.evidence/v1",
  "title": "Evidence Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_type", "created_at", "imported_at", "sensitivity", "allowed_scenarios", "not_allowed_scenarios", "quote_policy", "status", "tags"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.evidence/v1" },
    "source_id": { "$ref": "#/$defs/stableId" },
    "source_type": { "type": "string", "minLength": 1 },
    "created_at": { "$ref": "#/$defs/date" },
    "imported_at": { "$ref": "#/$defs/date" },
    "sensitivity": { "type": "string", "minLength": 1 },
    "allowed_scenarios": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "not_allowed_scenarios": { "$ref": "#/$defs/uniqueStrings" },
    "quote_policy": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "tags": { "$ref": "#/$defs/uniqueStrings" }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "date": { "type": "string", "format": "date" },
    "uniqueStrings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nonEmptyUniqueStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
