{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognitive-runtime.generation-manifest/v3",
  "title": "Composite Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "builder_format_version", "package_version", "source_revision", "authority", "domains", "sync_generation", "files"],
  "properties": {
    "schema_version": { "const": "cognitive-runtime.generation-manifest/v3" },
    "contract_version": { "const": "v2" },
    "builder_format_version": { "const": "generation-builder/v3" },
    "package_version": { "type": "string", "minLength": 1 },
    "source_revision": { "$ref": "#/$defs/authorityRevision" },
    "authority": { "$ref": "#/$defs/authority" },
    "domains": { "$ref": "#/$defs/domains" },
    "sync_generation": { "$ref": "#/$defs/generation" },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "authorityRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceRevision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "generation": { "type": "string", "pattern": "^generation-[a-f0-9]{64}$" },
    "projectionRevision": { "type": "string", "pattern": "^projection-[a-f0-9]{64}$" },
    "pointerRevision": { "type": "string", "pattern": "^pointer-[a-f0-9]{64}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "checksum"],
      "properties": {
        "revision": { "$ref": "#/$defs/authorityRevision" },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_id", "status", "projection_revision", "pointer_revision", "manifest_checksum", "source_revision", "as_of"],
      "properties": {
        "domain_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["active", "stale"] },
        "projection_revision": { "$ref": "#/$defs/projectionRevision" },
        "pointer_revision": { "$ref": "#/$defs/pointerRevision" },
        "manifest_checksum": { "$ref": "#/$defs/checksum" },
        "source_revision": { "$ref": "#/$defs/sourceRevision" },
        "as_of": { "type": "string", "format": "date-time" }
      }
    },
    "domains": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/domain" } },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checksum", "dependencies"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
