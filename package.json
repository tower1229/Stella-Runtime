{
  "name": "@tower1229/stella-cognitive-runtime",
  "version": "0.2.0",
  "description": "Instance-neutral cognitive runtime for OpenClaw",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "files": [
    "dist",
    "compatibility",
    "contracts/v2",
    "docs/CONFIGURATION.md",
    "docs/DATA-BOUNDARIES.md",
    "docs/OPERATIONS.md",
    "docs/SUPPORT.md",
    "docs/evidence/openclaw-2026.6.34.md",
    "skills/framework-admission",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "openclaw.plugin.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compatibility": "./compatibility/openclaw.json",
    "./contracts/v2/*": "./contracts/v2/*",
    "./test-runner": {
      "types": "./dist/testing/runner.d.ts",
      "import": "./dist/testing/runner.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stella-runtime-test": "./dist/testing/runner.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/openclaw/index.js"
    ]
  },
  "peerDependencies": {
    "openclaw": "2026.6.34"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/contracts/generated dist/contracts/",
    "generate:contracts": "json2ts -i contracts/v2 -o src/contracts/generated --cwd contracts/v2 --unknownAny --bannerComment '/* Generated from contracts/v2. Do not edit directly. */'",
    "check:generated": "npm run generate:contracts && git diff --exit-code -- src/contracts/generated",
    "lint": "npm run check:generated && git diff --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck && npm run build && node --test tests/**/*.test.mjs",
    "test:unit": "npm run build && node --test tests/unit/*.test.mjs",
    "test:contract": "npm run typecheck && npm run build && node --test tests/contract/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "test:pack-install": "npm run build && node --test --test-concurrency=1 tests/pack-install/*.test.mjs",
    "test:runner": "npm run build && node dist/testing/runner.js",
    "delivery:status": "node scripts/run-delivery-status.mjs",
    "verify:env": "node scripts/run-verification.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tower1229/Stella-Runtime.git"
  },
  "bugs": {
    "url": "https://github.com/tower1229/Stella-Runtime/issues"
  },
  "homepage": "https://github.com/tower1229/Stella-Runtime#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  }
}
